import "../mtb_2540.zk"

fn test_run():
    res := token_bucket_refill_2540(5.0, 10.0, 2.0, 1.0)
    diff := res - 32.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
