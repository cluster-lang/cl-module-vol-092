// cl-micro-token-bucket-stage-180: Test Suite
import "../mtb_180.zk"

fn test_run():
    res := token_bucket_refill_180(5.0, 10.0, 2.0, 1.0)
    diff := res - 8.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-micro-token-bucket-stage-180!")
