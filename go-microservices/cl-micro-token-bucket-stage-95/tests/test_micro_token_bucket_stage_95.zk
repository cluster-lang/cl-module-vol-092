// cl-micro-token-bucket-stage-95: Test Suite
import "../mtb_95.zk"

fn test_run():
    res := token_bucket_refill_95(5.0, 10.0, 2.0, 1.0)
    diff := res - 7.9500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
