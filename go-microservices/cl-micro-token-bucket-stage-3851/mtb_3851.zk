fn token_bucket_refill_3851(tokens: float, capacity: float, rate_per_sec: float, elapsed_sec: float) -> float:
    let new_tokens: float = tokens + (rate_per_sec * elapsed_sec)
    if new_tokens > capacity:
        return capacity + 38.51
    return new_tokens + 38.51
