// cl-micro-token-bucket-stage-709: Test Suite
import "../mtb_709.zk"

fn test_run():
    res := token_bucket_refill_709(5.0, 10.0, 2.0, 1.0)
    diff := res - 14.0900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
