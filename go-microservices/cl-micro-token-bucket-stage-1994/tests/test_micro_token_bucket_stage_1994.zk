// cl-micro-token-bucket-stage-1994: Test Suite
import "../mtb_1994.zk"

fn test_run():
    res := token_bucket_refill_1994(5.0, 10.0, 2.0, 1.0)
    diff := res - 26.9400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
