import "../mtb_331.zk"

fn test_run():
    res := token_bucket_refill_331(5.0, 10.0, 2.0, 1.0)
    diff := res - 10.3100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
