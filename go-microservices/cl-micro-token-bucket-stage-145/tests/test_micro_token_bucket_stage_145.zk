// cl-micro-token-bucket-stage-145: Test Suite
import "../mtb_145.zk"

fn test_run():
    res := token_bucket_refill_145(5.0, 10.0, 2.0, 1.0)
    diff := res - 8.4500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
